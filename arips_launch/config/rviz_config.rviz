    Name: Displays
    Property Tree Widget:
      Expanded:
        - /TF1/Frames1
        - /Plan global1/Offset1
        - /Path1/Offset1
        - /Trajectories1/Topic1
        - /Corrected Map1/Topic1
        - /Segmentation1/Status1
        - /Segmentation1/Topic1
        - /Segmentation1/Namespaces1
