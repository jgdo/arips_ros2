<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="ComputeRouteAndCount">
      <GetCurrentPose
        current_pose="{current_pose}" />

      <ComputeSemanticRoute
        start="{current_pose}"
        goal="{goal}"
        semantic_route="{semantic_route}"
        server_timeout="1000"
        error_code_id="{compute_route_error_code}" />
      
      <Inverter>
        <KeepRunningUntilFailure>
          <Sequence>
            <PopNextSemanticRouteSegment
             semantic_route="{semantic_route}"
             next_goal="{next_goal}"
             segment_type="{segment_type}"
             metadata_json="{metadata_json}"
            />
            <ComputePathToPose goal="{next_goal}" path="{path}" planner_id="{selected_planner}" error_code_id="{compute_path_error_code}" error_msg="{compute_path_error_msg}"/>
            <FollowPath path="{path}" controller_id="{selected_controller}" error_code_id="{follow_path_error_code}" error_msg="{follow_path_error_msg}" tracking_feedback="{tracking_feedback}"/>
          </Sequence>
        </KeepRunningUntilFailure>
      </Inverter>
    </Sequence>
  </BehaviorTree>
</root>
