<?xml version="1.0"?>
<!-- Simple 6 m x 4 m room, centered at the origin -->
<sdf version="1.10">
  <world name="rectangular_room">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.55 0.5 0.45 1</ambient>
            <diffuse>0.55 0.5 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="room_walls">
      <static>true</static>
      <!-- north / south walls: 6.2 m long incl. corners -->
      <link name="wall_north">
        <pose>0 2.05 1.0 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>6.2 0.1 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.2 0.1 2.0</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.85 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="wall_south">
        <pose>0 -2.05 1.0 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>6.2 0.1 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>6.2 0.1 2.0</size></box></geometry>
          <material>
            <ambient>0.9 0.9 0.85 1</ambient>
            <diffuse>0.9 0.9 0.85 1</diffuse>
          </material>
        </visual>
      </link>
      <!-- east / west walls: 4 m long -->
      <link name="wall_east">
        <pose>3.05 0 1.0 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 4.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 4.0 2.0</size></box></geometry>
          <material>
            <ambient>0.7 0.8 0.9 1</ambient>
            <diffuse>0.7 0.8 0.9 1</diffuse>
          </material>
        </visual>
      </link>
      <link name="wall_west">
        <pose>-3.05 0 1.0 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.1 4.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 4.0 2.0</size></box></geometry>
          <material>
            <ambient>0.7 0.8 0.9 1</ambient>
            <diffuse>0.7 0.8 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
