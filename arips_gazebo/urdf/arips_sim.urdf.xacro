<?xml version="1.0"?>
<!-- Gazebo wrapper around arips_description. Adds everything the real robot gets from
     elsewhere (static TFs in arips_launch, the base microcontroller, sensor drivers). -->
<robot name="arips" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="sim" default="true" />
    <xacro:arg name="controllers_file" default="$(find arips_gazebo)/config/controllers.yaml" />

    <xacro:include filename="$(find arips_description)/urdf/arips_onshape.urdf.xacro" />

    <xacro:property name="PI" value="3.14159265359" />
    <xacro:property name="wheel_radius" value="0.055" />
    <xacro:property name="wheel_width" value="0.02" />
    <xacro:property name="wheel_separation" value="0.31" />
    <xacro:property name="wheel_mass" value="0.3" />
    <xacro:property name="caster_radius" value="0.02" />
    <xacro:property name="caster_mass" value="0.05" />

    <!-- Differential drive pivot point, published by a static TF in arips_launch/startup.launch.py
         on the real robot. Made the root link so diff_drive_controller can publish odom -> arips_wheel_center. -->
    <link name="arips_wheel_center" />
    <joint name="arips_wheel_center_joint" type="fixed">
        <origin xyz="-0.1 0 0" rpy="0 0 0" />
        <parent link="arips_wheel_center" />
        <child link="base_link" />
    </joint>

    <!-- The Onshape export has near-zero masses; give the base a realistic weight for stable contact -->
    <link name="sim_ballast">
        <inertial>
            <mass value="6.0" />
            <origin xyz="0 0 0" rpy="0 0 0" />
            <inertia ixx="0.093" ixy="0" ixz="0" iyy="0.093" iyz="0" izz="0.176" />
        </inertial>
    </link>
    <joint name="sim_ballast_joint" type="fixed">
        <origin xyz="0 0 0.16" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="sim_ballast" />
    </joint>

    <!-- Drive wheels. Collision only, the visuals come from the left_wheel/right_wheel meshes. -->
    <xacro:macro name="drive_wheel" params="side y">
        <link name="${side}_drive_wheel">
            <inertial>
                <mass value="${wheel_mass}" />
                <origin xyz="0 0 0" rpy="0 0 0" />
                <inertia ixx="${wheel_mass * (3 * wheel_radius**2 + wheel_width**2) / 12}" ixy="0" ixz="0"
                         iyy="${wheel_mass * wheel_radius**2 / 2}" iyz="0"
                         izz="${wheel_mass * (3 * wheel_radius**2 + wheel_width**2) / 12}" />
            </inertial>
            <collision>
                <origin xyz="0 0 0" rpy="${PI / 2} 0 0" />
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}" />
                </geometry>
            </collision>
        </link>
        <joint name="${side}_drive_wheel_joint" type="continuous">
            <origin xyz="0 ${y} ${wheel_radius}" rpy="0 0 0" />
            <axis xyz="0 1 0" />
            <parent link="arips_wheel_center" />
            <child link="${side}_drive_wheel" />
        </joint>
        <gazebo reference="${side}_drive_wheel">
            <mu1>1.0</mu1>
            <mu2>1.0</mu2>
        </gazebo>
    </xacro:macro>

    <xacro:drive_wheel side="left" y="${wheel_separation / 2}" />
    <xacro:drive_wheel side="right" y="${-wheel_separation / 2}" />

    <!-- Frictionless casters. The front one hovers 2 mm above the floor and only catches tipping. -->
    <xacro:macro name="caster" params="name x lift">
        <link name="${name}">
            <inertial>
                <mass value="${caster_mass}" />
                <origin xyz="0 0 0" rpy="0 0 0" />
                <inertia ixx="${0.4 * caster_mass * caster_radius**2}" ixy="0" ixz="0"
                         iyy="${0.4 * caster_mass * caster_radius**2}" iyz="0"
                         izz="${0.4 * caster_mass * caster_radius**2}" />
            </inertial>
            <visual>
                <geometry>
                    <sphere radius="${caster_radius}" />
                </geometry>
            </visual>
            <collision>
                <geometry>
                    <sphere radius="${caster_radius}" />
                </geometry>
            </collision>
        </link>
        <joint name="${name}_joint" type="fixed">
            <origin xyz="${x} 0 ${caster_radius + lift}" rpy="0 0 0" />
            <parent link="base_link" />
            <child link="${name}" />
        </joint>
        <gazebo reference="${name}">
            <mu1>0.0</mu1>
            <mu2>0.0</mu2>
        </gazebo>
    </xacro:macro>

    <xacro:caster name="rear_caster" x="-0.17" lift="0.0" />
    <xacro:caster name="front_caster" x="0.18" lift="0.002" />

    <!-- Lidar (YDLIDAR X4), same pose as the static TF in arips_launch/lidar.launch.py -->
    <link name="laser_frame" />
    <joint name="laser_joint" type="fixed">
        <origin xyz="0 0 0.165" rpy="0 0 ${PI}" />
        <parent link="base_link" />
        <child link="laser_frame" />
    </joint>
    <gazebo reference="laser_frame">
        <sensor name="lidar" type="gpu_lidar">
            <topic>scan</topic>
            <frame_id>laser_frame</frame_id>
            <update_rate>10</update_rate>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <lidar>
                <scan>
                    <horizontal>
                        <samples>500</samples>
                        <resolution>1</resolution>
                        <min_angle>${-PI}</min_angle>
                        <max_angle>${PI}</max_angle>
                    </horizontal>
                </scan>
                <!-- min range is larger than the base radius, so the lidar does not see the robot itself -->
                <range>
                    <min>0.235</min>
                    <max>12.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </lidar>
        </sensor>
    </gazebo>

    <!-- Kinect, same pose as the static TF in arips_launch/startup.launch.py -->
    <link name="kinect_link" />
    <joint name="kinect_link_joint" type="fixed">
        <origin xyz="-0.025 0 0.03" rpy="0 0 ${-PI / 2}" />
        <parent link="kinect_mount" />
        <child link="kinect_link" />
    </joint>

    <!-- Camera sensor in front of the Kinect mesh, looking along kinect_mount +x -->
    <link name="kinect_camera_link" />
    <joint name="kinect_camera_joint" type="fixed">
        <origin xyz="0.035 0 0.05" rpy="0 0 0" />
        <parent link="kinect_mount" />
        <child link="kinect_camera_link" />
    </joint>
    <link name="kinect_camera_optical_frame" />
    <joint name="kinect_camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="${-PI / 2} 0 ${-PI / 2}" />
        <parent link="kinect_camera_link" />
        <child link="kinect_camera_optical_frame" />
    </joint>
    <gazebo reference="kinect_camera_link">
        <sensor name="kinect" type="rgbd_camera">
            <topic>kinect</topic>
            <frame_id>kinect_camera_optical_frame</frame_id>
            <update_rate>30</update_rate>
            <always_on>true</always_on>
            <camera>
                <!-- ~90 deg x 74.3 deg. Gazebo derives the vertical FOV from the aspect ratio
                     (square pixels), so at 4:3 the horizontal FOV is set to 90.58 deg:
                     2 * atan(480 / 640 * tan(90.58 deg / 2)) = 74.3 deg -->
                <horizontal_fov>1.581</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>10.0</far>
                </clip>
                <depth_camera>
                    <clip>
                        <near>0.25</near>
                        <far>3.0</far>
                    </clip>
                </depth_camera>
            </camera>
        </sensor>
    </gazebo>

    <ros2_control name="arips_sim" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <xacro:macro name="velocity_joint" params="name">
            <joint name="${name}">
                <command_interface name="velocity" />
                <state_interface name="position" />
                <state_interface name="velocity" />
            </joint>
        </xacro:macro>
        <xacro:macro name="position_joint" params="name initial_value:=0.0">
            <joint name="${name}">
                <command_interface name="position" />
                <state_interface name="position">
                    <param name="initial_value">${initial_value}</param>
                </state_interface>
                <state_interface name="velocity" />
            </joint>
        </xacro:macro>
        <xacro:velocity_joint name="left_drive_wheel_joint" />
        <xacro:velocity_joint name="right_drive_wheel_joint" />
        <!-- Start pose: arm in "door_grasp_folded" (arips_moveit_config/config/arips.srdf),
             Kinect tilted -60 deg -->
        <xacro:position_joint name="joint_slider" initial_value="0.8" />
        <xacro:position_joint name="joint_2" initial_value="-1.7424" />
        <xacro:position_joint name="joint_3" initial_value="1.8494" />
        <xacro:position_joint name="joint_4" initial_value="-1.4444" />
        <xacro:position_joint name="joint_door_gripper" />
        <xacro:position_joint name="kinect_joint" initial_value="${-PI / 3}" />
    </ros2_control>

    <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(arg controllers_file)</parameters>
        </plugin>
        <!-- Ground truth odometry: the world pose of arips_wheel_center, published as
             odom -> arips_wheel_center (TF) and on /csm_odom. With map -> odom as identity
             (startup.launch.py), the map frame is the Gazebo world frame. -->
        <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
            <odom_frame>odom</odom_frame>
            <robot_base_frame>arips_wheel_center</robot_base_frame>
            <odom_publish_frequency>50</odom_publish_frequency>
            <odom_topic>ground_truth/odom</odom_topic>
            <tf_topic>ground_truth/tf</tf_topic>
            <dimensions>2</dimensions>
        </plugin>
    </gazebo>
</robot>
