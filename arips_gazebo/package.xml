<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arips_gazebo</name>
  <version>0.0.0</version>
  <description>Gazebo simulation of the ARIPS robot</description>
  <maintainer email="markprediger@gmail.com">jgdo</maintainer>
  <license>GPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>arips_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_image</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>forward_command_controller</exec_depend>
  <exec_depend>diff_drive_controller</exec_depend>
  <exec_depend>compressed_image_transport</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>arips_launch</exec_depend>
  <exec_depend>arips_web_dashboard</exec_depend>
  <exec_depend>arips_voice_interface</exec_depend>
  <exec_depend>component_manager</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>arips_maps</exec_depend>
  <exec_depend>arips_semantic_map</exec_depend>
  <exec_depend>arips_route_graph</exec_depend>
  <exec_depend>arips_moveit_config</exec_depend>
  <exec_depend>joint_trajectory_server</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
