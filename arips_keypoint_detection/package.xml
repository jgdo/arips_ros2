<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arips_keypoint_detection</name>
  <version>0.0.0</version>
  <description>Generic keypoint detection framework for RGB-D images: dataset extraction from rosbags and keypoint annotation tool.</description>
  <maintainer email="jgdo@todo.todo">jgdo</maintainer>
  <license>TODO</license>

  <exec_depend>arips_keypoint_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>python_qt_binding</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- training (learning/train.py, export_onnx.py) needs torch, torchvision and onnx from the venv;
       the detector node only needs onnxruntime (pip) or falls back to cv2.dnn -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
