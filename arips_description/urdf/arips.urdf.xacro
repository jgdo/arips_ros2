<?xml version="1.0"?>
<!-- Main robot description: the Onshape geometry (arips_onshape.urdf.xacro, generated at build
     time from arips_description_onshape_raw.urdf) plus the servo configuration. -->
<robot name="arips" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:arg name="use_ros2_control" default="false" />
    <xacro:arg name="serial_port" default="/dev/feetech_servo" />
    <xacro:arg name="baud_rate" default="500000" />
    <xacro:arg name="arm_enabled" default="true" />
    <xacro:arg name="kinect_enabled" default="true" />
    <xacro:arg name="enable_mock_mode" default="false" />
    <xacro:arg name="sim" default="false" />
    <!-- Effort limit of the arm joints 2-4 [Nm]. Gazebo uses it as the force limit that holds
         the joints in place; the sim raises it (see arips_gazebo/urdf/arips_sim.urdf.xacro). -->
    <xacro:arg name="arm_joint_effort" default="1" />

    <xacro:include filename="$(find arips_description)/urdf/arips_onshape.urdf.xacro" />
    <xacro:include filename="$(find arips_description)/urdf/arips.ros2_control.xacro" />

    <xacro:if value="$(arg use_ros2_control)">
        <xacro:ros2_control_arips serial_port="$(arg serial_port)" baud_rate="$(arg baud_rate)" arm_enabled="$(arg arm_enabled)" kinect_enabled="$(arg kinect_enabled)" enable_mock_mode="'$(arg enable_mock_mode)'" />
    </xacro:if>
</robot>
