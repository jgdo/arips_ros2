<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arips_actions</name>
  <version>0.0.0</version>
  <description>ROS 2 action servers for ARIPS robot behaviors.</description>
  <maintainer email="markprediger@gmail.com">Mark Prediger</maintainer>
  <license>BSD</license>

  <depend>arips_action_msgs</depend>
  <depend>arips_keypoint_msgs</depend>
  <depend>arips_semantic_map_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>rclpy</depend>
  <depend>rosetta_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- image decoding helpers and command_rate_limiter for grab_door_handle_policy_server;
       the model itself (lerobot_policy_doorhandle, torch) comes from the workspace venv -->
  <exec_depend>arips_keypoint_detection</exec_depend>
  <exec_depend>arips_models</exec_depend>
  <exec_depend>arips_lerobot</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>